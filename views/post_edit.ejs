<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Blog | ByteScribe</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/public/main.css" />
  </head>
  <body>
    <div class="page-wrapper d-flex flex-column min-vh-100">
      <div class="container-fluid px-4">
        <%- include("partials/header.ejs") %>
      </div>

      <main class="flex-fill d-flex flex-column justify-content-center align-items-center text-center py-5 px-4 gap-3">
        <div class="w-100">
          <div class="text-center mb-4">
            <h2 class="mb-3">Edit Blog</h2>
            <p class="text-body-secondary">Update the title or content for your saved post.</p>
          </div>

          <% if (errorMessage) { %>
            <div class="alert alert-danger text-center"><%= errorMessage %></div>
          <% } %>

          <form action="/post/<%= id %>/edit" method="POST" class="d-flex flex-column justify-content-center align-items-center gap-3 w-100">
            <input
              type="text"
              name="title"
              class="form-control w-50"
              placeholder="Enter Title..."
              aria-label="Title"
              value="<%= post?.title || '' %>"
            />
            <textarea
              name="content"
              class="form-control w-50"
              placeholder="Enter Content..."
              aria-label="Content"
              rows="6"
            ><%= post?.content || '' %></textarea>
            <div class="d-flex flex-wrap justify-content-center gap-3">
              <button type="submit" class="btn btn-primary">Save Changes</button>
              <a href="/post/new" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </main>

      <div class="container-fluid px-3">
        <%- include("partials/footer.ejs") %>
      </div>
    </div>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= post ? (post.title || 'Untitled') : 'Post not found' %> | ByteScribe</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/public/main.css" />
  </head>
  <body>
    <div class="page-wrapper d-flex flex-column min-vh-100">
      <div class="container-fluid px-4">
        <%- include("partials/header.ejs") %>
      </div>

      <main class="flex-fill py-5 px-4">
        <div class="row justify-content-center">
          <div class="col-12 col-md-8 col-lg-6">
            <% if (!post) { %>
              <div class="alert alert-danger text-center">Post not found.</div>
            <% } else { %>
              <div class="card shadow-sm">
                <div class="card-body">
                  <h2 class="card-title mb-3"><%= post.title || 'Untitled' %></h2>
                  <p class="card-text"><%= post.content %></p>
                </div>
                <div class="card-footer bg-white border-0 d-flex flex-wrap gap-2">
                  <a href="/post/<%= id %>/edit" class="btn btn-primary">Edit</a>
                  <form action="/post/<%= id %>/delete" method="POST" class="m-0">
                    <button type="submit" class="btn btn-danger">Delete</button>
                  </form>
                  <a href="/post/new" class="btn btn-outline-secondary">Back to posts</a>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </main>

      <div class="container-fluid px-3">
        <%- include("partials/footer.ejs") %>
      </div>
    </div>
  </body>
</html>

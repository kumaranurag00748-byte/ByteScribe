<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Posts at ByteScribe</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/public/main.css" />
  </head>
  <body>
    <div class="page-wrapper d-flex flex-column min-vh-100">
      <div class="container-fluid px-4">
        <%- include("partials/header.ejs") %>
      </div>

      <main class="flex-fill py-5 px-4">
        <div class="text-center py-5">
          <h2 class="mb-3">Published blogs</h2>
          <p class="text-body-secondary">
            Browse your saved posts and use the actions below to view, edit, or delete any entry.
          </p>
        </div>

        <% if (posts.length === 0) { %>
          <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
              <div class="alert alert-secondary text-center">
                No blogs yet.
              </div>
            </div>
          </div>
        <% } %>

        <div class="blog-cards-wrapper mx-auto">
          <div class="row justify-content-center g-4">
            <% posts.forEach((post) => { %>
            <div class="col-12 col-md-6">
              <div class="card h-100 blog-card">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title"><%= post.title || 'Untitled' %></h5>
                  <p class="card-text text-muted text-truncate"><%= post.content.length > 220 ? post.content.slice(0, 220) + '...' : post.content %></p>
                  <div class="mt-auto d-flex flex-wrap gap-2 card-actions">
                    <a href="/post/<%= post.id %>" class="btn btn-outline-primary btn-sm">View</a>
                    <a href="/post/<%= post.id %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
                    <form action="/post/<%= post.id %>/delete" method="POST" class="m-0">
                      <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
            </div>
        </div>
      </main>

      <div class="container-fluid px-3">
        <%- include("partials/footer.ejs") %>
      </div>
    </div>
  </body>
</html>
